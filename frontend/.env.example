# Your backend URL. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Analytics (GA4) measurement ID, e.g. G-XXXXXXXXXX. Leave unset to disable.
NEXT_PUBLIC_GA_ID=

# Manual AdSense ad unit slot IDs (Ads > By ad unit > Display ads in the
# AdSense dashboard). Leave unset and that ad slot just won't render — turn
# off Auto ads for this site in the AdSense dashboard first, or these will
# show alongside Google's own auto-placed ads.
NEXT_PUBLIC_AD_SLOT_RESULT=
NEXT_PUBLIC_AD_SLOT_FOOTER=

# --- PostHog (product analytics) ---------------------------------------
# Project API key from PostHog > Settings > Project. Leave unset to disable
# PostHog entirely; GA4 keeps working on its own.
NEXT_PUBLIC_POSTHOG_KEY=

# Leave as /ingest to send events through this site's own domain (the
# rewrite in next.config.js), which is what keeps ad blockers from
# dropping them. Set to https://us.i.posthog.com to bypass the proxy.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Region of the PostHog app you log into (us or eu).
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# EU project? also set these two so the proxy points at the EU ingest:
# POSTHOG_INGEST_HOST=https://eu.i.posthog.com
# POSTHOG_ASSET_HOST=https://eu-assets.i.posthog.com

# "true" turns on PostHog autocapture (every click/input automatically).
# Off by default: the hand-written events cover the funnel, and autocapture
# is what burns the monthly event quota. Turn on for short exploration.
NEXT_PUBLIC_POSTHOG_AUTOCAPTURE=false

# "true" turns on session replay. Off by default (cost + privacy); all
# inputs are masked when it is on, so pasted links are never recorded.
NEXT_PUBLIC_POSTHOG_RECORDING=false
