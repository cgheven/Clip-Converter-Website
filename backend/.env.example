PORT=4000

# Comma-separated frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Temp storage for processed files
DOWNLOAD_DIR=./downloads

# Delete finished files after this many minutes
FILE_TTL_MINUTES=20
CLEANUP_INTERVAL_MINUTES=5

# How many downloads may run at once (protects VPS CPU/RAM)
MAX_CONCURRENT_JOBS=2

# Max minutes a single download may run before being killed
JOB_TIMEOUT_MINUTES=15

# Cache /api/formats responses for this many minutes (makes repeat lookups instant)
FORMATS_CACHE_MINUTES=30

# Per-IP rate limits (15 min window)
FORMATS_RATE_LIMIT=40
DOWNLOAD_RATE_LIMIT=12

# Binaries (leave as-is if they're on PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Optional: path to a cookies.txt file for Instagram / age-gated content
# COOKIES_FILE=./cookies.txt
