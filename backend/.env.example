PORT=4000

# Comma-separated frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Temp storage for processed files
DOWNLOAD_DIR=./downloads

# Delete finished files after this many minutes
FILE_TTL_MINUTES=20
CLEANUP_INTERVAL_MINUTES=5

# How many downloads may run at once (protects VPS CPU/RAM)
MAX_CONCURRENT_JOBS=2

# Max minutes a single download may run before being killed
JOB_TIMEOUT_MINUTES=15

# Cache /api/formats responses for this many minutes (makes repeat lookups instant)
FORMATS_CACHE_MINUTES=30

# Per-IP rate limits (15 min window)
FORMATS_RATE_LIMIT=40
DOWNLOAD_RATE_LIMIT=12

# Binaries (leave as-is if they're on PATH)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Cookies file (Netscape format) from a throwaway logged-in account.
# Fixes most Instagram/Facebook "private" failures, and makes YouTube's
# web client far less likely to hit the bot wall. Never use your personal
# account's cookies here.
# COOKIES_FILE=./cookies.txt

# URL of a self-hosted bgutil-ytdlp-pot-provider container (see README).
# This is the real fix for YouTube's "Sign in to confirm you're not a bot"
# error. Leave unset to rely on the player-client fallback chain alone,
# which works but is less reliable and caps some videos below 1080p.
# POT_PROVIDER_URL=http://127.0.0.1:4416

# Use aria2c (multi-connection downloader) instead of yt-dlp's default
# single-connection fetch — the single biggest download-speed lever.
# Requires `apt install aria2` on the host first, or every download fails.
# USE_ARIA2C=true

# URL of the warm yt-dlp extraction microservice (extractor_service.py),
# run separately via `uvicorn extractor_service:app --port 4500`. Skips the
# Python-startup + 1700-extractor-load cost a fresh `yt-dlp` subprocess
# pays on every single /api/formats call — the dominant chunk of latency
# on every platform, not just YouTube. Falls back to the subprocess path
# automatically if this is unreachable, so it's safe to leave unset.
# EXTRACTOR_SERVICE_URL=http://127.0.0.1:4500
